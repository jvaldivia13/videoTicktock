OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_TOKEN=your_gateway_token_here

# LLM Configuration
PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b
FALLBACK_MODEL=deepseek/deepseek-v4-flash

# TikTok API (get from TikTok Developer Portal)
TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret
TIKTOK_ACCESS_TOKEN=your_access_token
TIKTOK_REFRESH_TOKEN=your_refresh_token

# Stock Media APIs
PEXELS_API_KEY=your_pexels_key
STORYBLOCKS_API_KEY=your_storyblocks_key
EPIDEMIC_SOUND_API_KEY=your_epidemic_key

# YouTube Audio Library (no key needed, public)
# ARTlist_API_KEY=your_artlist_key

# Video Generation
FFMPEG_PATH=ffmpeg
VIDEO_OUTPUT_DIR=./data/videos
TEMP_DIR=./tmp

# Scheduling
DAILY_CRON_TIME=05:30
POST_TIME_MORNING=06:30
POST_TIME_EVENING=19:30
TIMEZONE=America/Lima

# Swarm Configuration
MAX_ITERATIONS=3
SHARED_MEMORY_PATH=./data/swarm-memory
LOG_LEVEL=info

# Monitoring
WEBHOOK_URL=your_webhook_for_notifications